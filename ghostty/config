# Ghostty overrides. Inspect defaults with `ghostty +show-config --default --docs`.
# Option reference: https://ghostty.org/docs/config/reference
font-family = "JetBrains Mono"
font-size = 14

cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 3
cursor-color = #FFFFFF
cursor-text = #000000
shell-integration-features = no-cursor,ssh-terminfo,ssh-env

window-padding-x = 15
window-padding-y = 10
background = #000000
background-opacity = 1.00
macos-option-as-alt = true
keybind = shift+enter=text:\n

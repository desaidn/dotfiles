#!/usr/bin/expect -f

set timeout 10
set repo_root [file normalize [file join [file dirname [info script]] ../..]]
set suffix [pid]
set temp_root "/tmp"
if {[info exists env(TMPDIR)] && [file isdirectory $env(TMPDIR)]} {
  set temp_root [file normalize $env(TMPDIR)]
}
set host_socket [file join $temp_root "codex-hunk-render-host-$suffix.sock"]
set direct_socket [file join $temp_root "codex-hunk-render-direct-$suffix.sock"]
set nvim_socket [file join $temp_root "codex-hunk-render-nvim-$suffix.sock"]
set startup_host_socket [file join $temp_root "codex-hunk-render-startup-host-$suffix.sock"]
set manual_host_socket [file join $temp_root "codex-hunk-render-manual-host-$suffix.sock"]
set startup_nvim_socket [file join $temp_root "codex-hunk-render-startup-nvim-$suffix.sock"]
set manual_nvim_socket [file join $temp_root "codex-hunk-render-manual-nvim-$suffix.sock"]
set fixture ""
set second_fixture ""
set review_fixture ""
set startup_fixture ""
set manual_fixture ""
set host_spawn_id ""
set host_slave ""
set direct_hunk_pid ""
set nvim_hunk_pid ""
set startup_hunk_pid ""
set manual_hunk_pid ""

proc capture {socket target} {
  return [exec tmux -S $socket capture-pane -p -t $target]
}

proc capture_ansi {socket target} {
  return [exec tmux -S $socket capture-pane -p -e -t $target]
}

proc ansi_palette {screen} {
  return [lsort -unique [regexp -all -inline \
    {(?:38|48|58);(?:2;[0-9]+;[0-9]+;[0-9]+|5;[0-9]+)} $screen]]
}

proc strip_ansi {text} {
  regsub -all {\x1b\[[0-9:;<=>?]*[ -/]*[@-~]} $text {} text
  regsub -all {\x1b[()][0-9A-Za-z]} $text {} text
  return $text
}

proc ansi_style_sequence {line} {
  set styles {}
  foreach sequence [regexp -all -inline {\x1b\[[0-9:;]*m} $line] {
    lappend styles [string range $sequence 2 end-1]
  }
  return $styles
}

proc content_style_signatures {screen needles} {
  set signatures {}
  foreach needle $needles {
    set matches {}
    foreach line [split $screen "\n"] {
      if {[string first $needle [strip_ansi $line]] >= 0} {
        lappend matches [ansi_style_sequence $line]
      }
    }
    if {[llength $matches] != 1} {
      error "expected exactly one styled line containing '$needle', found [llength $matches]"
    }
    lappend signatures [list $needle [lindex $matches 0]]
  }
  return $signatures
}

proc render_signature {screen needles} {
  set palette [ansi_palette $screen]
  if {[llength $palette] == 0} { error "render has no extended ANSI colors" }
  return [list $palette [content_style_signatures $screen $needles]]
}

proc wait_for_render_signature {socket target needles} {
  global timeout
  set previous {}
  set stable 0
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![catch { render_signature [capture_ansi $socket $target] $needles } signature]} {
      if {$signature eq $previous} {
        incr stable
        if {$stable == 3} { return $signature }
      } else {
        set previous $signature
        set stable 0
      }
    }
    after 100
  }
  error "timed out waiting for stable content-bound ANSI styles on $target"
}

proc printable_palette {palette} {
  if {[llength $palette] == 0} { return "<empty>" }
  return [join $palette {, }]
}

proc printable_content_styles {signatures} {
  set rendered {}
  foreach signature $signatures {
    lassign $signature needle styles
    lappend rendered "$needle => [join $styles {, }]"
  }
  return [join $rendered {; }]
}

proc palette_has_rgb {palette} {
  foreach color $palette {
    if {[regexp {^(?:38|48|58);2;} $color]} { return 1 }
  }
  return 0
}

proc wait_for_screen {socket target pattern} {
  global timeout
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![catch { capture $socket $target } screen] && [regexp $pattern $screen]} {
      return $screen
    }
    after 100
  }
  error "timed out waiting for $pattern on $target"
}

proc wait_for_row {socket target row pattern} {
  global timeout
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![catch { capture $socket $target } screen]} {
      set content [lindex [split $screen "\n"] $row]
      if {[regexp $pattern $content]} { return $screen }
    }
    after 100
  }
  error "timed out waiting for $pattern on row $row of $target"
}

proc current_nvim_size {socket} {
  set width [exec nvim --server $socket --remote-expr \
    {luaeval("vim.api.nvim_win_get_width(0)")}]
  set height [exec nvim --server $socket --remote-expr \
    {luaeval("vim.api.nvim_win_get_height(0)")}]
  return [list $width $height]
}

proc wait_for_nvim_size {socket expected_width expected_height} {
  global timeout
  set size {unknown unknown}
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![catch { current_nvim_size $socket } size] &&
        [lindex $size 0] == $expected_width && [lindex $size 1] == $expected_height} {
      return $size
    }
    after 100
  }
  error "timed out waiting for Neovim size ${expected_width}x${expected_height}; last size was [join $size x]"
}

proc current_nvim_terminal_pid {socket} {
  if {[catch {
    exec nvim --server $socket --remote-expr \
      {jobpid(getbufvar(bufnr(), 'terminal_job_id'))}
  } pid]} {
    return ""
  }

  set pid [string trim $pid]
  if {![string is integer -strict $pid] || $pid <= 0} { return "" }
  return $pid
}

proc wait_for_nvim_terminal_pid {socket} {
  global timeout
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    set pid [current_nvim_terminal_pid $socket]
    if {$pid ne ""} { return $pid }
    after 100
  }
  error "timed out waiting for Neovim's terminal job"
}

proc current_nvim_terminal_pids {socket} {
  if {[catch {
    exec nvim --server $socket --remote-expr \
      {luaeval("HunkRenderTerminalPids()")}
  } raw]} {
    return {}
  }
  return [regexp -all -inline {[0-9]+} $raw]
}

proc terminal_buffer_count {socket} {
  return [exec nvim --server $socket --remote-expr \
    {luaeval("HunkRenderTerminalBufferCount()")}]
}

proc wait_for_terminal_buffer_count {socket expected} {
  global timeout
  set count unknown
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![catch { terminal_buffer_count $socket } count] && $count == $expected} {
      return $count
    }
    after 100
  }
  error "timed out waiting for $expected Neovim terminal buffers; last count was $count"
}

proc active_pane {socket target} {
  set panes [exec tmux -S $socket list-panes -t $target -F {#{pane_id} #{pane_active}}]
  foreach pane [split $panes "\n"] {
    if {[lindex $pane 1] == 1} { return [lindex $pane 0] }
  }
  error "could not find the active pane in $target"
}

proc wait_for_active_pane_change {socket target previous} {
  global timeout
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![catch { active_pane $socket $target } pane] && $pane ne $previous} { return $pane }
    after 100
  }
  error "host tmux did not navigate away from pane $previous"
}

proc process_running {pid} {
  if {![string is integer -strict $pid] || $pid <= 0} { return 0 }
  return [expr {![catch { exec kill -0 $pid }]}]
}

proc wait_for_process_exit {pid} {
  global timeout
  set attempts [expr {$timeout * 10}]
  for {set attempt 0} {$attempt < $attempts} {incr attempt} {
    if {![process_running $pid]} { return 1 }
    after 100
  }
  return 0
}

proc terminate_process {label pid} {
  set errors {}
  if {![process_running $pid]} { return $errors }

  catch { exec kill -TERM $pid }
  if {[wait_for_process_exit $pid]} { return $errors }

  lappend errors "$label did not exit after SIGTERM; forced cleanup was required"
  catch { exec kill -KILL $pid }
  if {![wait_for_process_exit $pid]} { lappend errors "$label process $pid survived SIGKILL" }
  return $errors
}

proc cleanup {sockets files fixtures} {
  global nvim_socket startup_nvim_socket manual_nvim_socket direct_hunk_pid nvim_hunk_pid startup_hunk_pid manual_hunk_pid
  set errors {}

  foreach owned [list \
      [list $nvim_socket $nvim_hunk_pid "Neovim-owned Hunk"] \
      [list $startup_nvim_socket $startup_hunk_pid "startup Neovim-owned Hunk"] \
      [list $manual_nvim_socket $manual_hunk_pid "manual Neovim-owned Hunk"]] {
    lassign $owned socket remembered_pid label
    if {[file exists $socket]} {
      set hunk_pids [current_nvim_terminal_pids $socket]
      if {$remembered_pid ne "" && [lsearch -exact $hunk_pids $remembered_pid] < 0} {
        lappend hunk_pids $remembered_pid
      }
      catch { exec nvim --server $socket --remote-expr {execute('qa!')} }
    } else {
      set hunk_pids {}
      if {$remembered_pid ne ""} { lappend hunk_pids $remembered_pid }
    }
    foreach pid $hunk_pids {
      if {![wait_for_process_exit $pid]} {
        lappend errors "$label process $pid remained after Neovim exit"
        set errors [concat $errors [terminate_process $label $pid]]
      }
    }
  }
  set errors [concat $errors [terminate_process "direct Hunk" $direct_hunk_pid]]

  foreach socket $sockets { catch { exec tmux -S $socket kill-server } }
  foreach path $files {
    catch { file delete -force $path }
    if {[file exists $path]} { lappend errors "could not remove $path" }
  }
  foreach fixture $fixtures {
    if {$fixture eq ""} { continue }
    catch { file delete -force $fixture }
    if {[file exists $fixture]} { lappend errors "could not remove $fixture" }
  }
  return $errors
}

proc run_test {} {
  global repo_root suffix temp_root host_socket direct_socket nvim_socket startup_host_socket manual_host_socket
  global startup_nvim_socket manual_nvim_socket fixture second_fixture review_fixture startup_fixture manual_fixture host_spawn_id host_slave
  global direct_hunk_pid nvim_hunk_pid startup_hunk_pid manual_hunk_pid

  set fixture [exec mktemp -d [file join $temp_root "codex-hunk-render-$suffix.XXXXXX"]]
  set sample [open "$fixture/sample.txt" w]
  puts $sample "one\ntwo\nthree\nfour\nfive"
  close $sample
  exec git -C $fixture init -q
  exec git -C $fixture add sample.txt
  exec git -C $fixture -c user.name=Test -c user.email=test@example.com commit -qm base
  set sample [open "$fixture/sample.txt" w]
  puts $sample "one\nTWO changed\nthree\nFOUR changed\nfive\nsix"
  close $sample

  set second_fixture [exec mktemp -d [file join $temp_root "codex-hunk-render-second-$suffix.XXXXXX"]]
  set sample [open "$second_fixture/second.txt" w]
  puts $sample "alpha\nbeta\ngamma\ndelta"
  close $sample
  exec git -C $second_fixture init -q
  exec git -C $second_fixture add second.txt
  exec git -C $second_fixture -c user.name=Test -c user.email=test@example.com commit -qm base
  set sample [open "$second_fixture/second.txt" w]
  puts $sample "alpha\nBETA changed\ngamma\nDELTA changed\nepsilon"
  close $sample

  set review_fixture [exec mktemp -d [file join $temp_root "codex-hunk-render-review-$suffix.XXXXXX"]]
  set palette_file [open "$review_fixture/palette.txt" w]
  puts $palette_file "red\ngreen\nblue"
  close $palette_file
  exec git -C $review_fixture init -q
  exec git -C $review_fixture add palette.txt
  exec git -C $review_fixture -c user.name=Test -c user.email=test@example.com commit -qm base
  set review_base [string trim [exec git -C $review_fixture rev-parse HEAD]]
  set palette_file [open "$review_fixture/palette.txt" w]
  puts $palette_file "red\nGREEN changed\nblue\npeach"
  close $palette_file
  exec git -C $review_fixture add palette.txt
  exec git -C $review_fixture -c user.name=Test -c user.email=test@example.com commit -qm change
  set review_head [string trim [exec git -C $review_fixture rev-parse HEAD]]

  set startup_fixture [exec mktemp -d [file join $temp_root "codex-hunk-render-startup-$suffix.XXXXXX"]]
  set manual_fixture [exec mktemp -d [file join $temp_root "codex-hunk-render-manual-$suffix.XXXXXX"]]
  exec git clone -q $review_fixture $startup_fixture
  exec git clone -q $review_fixture $manual_fixture

  set render_init "$repo_root/nvim/tests/terminal_tool_hunk_render_init.lua"
  exec tmux -S $startup_host_socket -f /dev/null new-session -d -x 80 -y 24 -s startup -c $startup_fixture \
    "/usr/bin/env TERM=tmux-256color COLORTERM=truecolor HUNK_RENDER_FIXTURE=$startup_fixture HUNK_RENDER_SECOND_FIXTURE=$startup_fixture DOTFILES_REPO_ROOT=$repo_root HUNK_RENDER_START_MODE=startup DEVFLOW_REVIEW_BASE_OID=$review_base DEVFLOW_REVIEW_HEAD_OID=$review_head nvim --clean --listen $startup_nvim_socket -u $render_init +HunkReview"
  exec tmux -S $manual_host_socket -f /dev/null new-session -d -x 80 -y 24 -s manual -c $manual_fixture \
    "/usr/bin/env TERM=tmux-256color COLORTERM=truecolor HUNK_RENDER_FIXTURE=$manual_fixture HUNK_RENDER_SECOND_FIXTURE=$manual_fixture DOTFILES_REPO_ROOT=$repo_root HUNK_RENDER_START_MODE=manual DEVFLOW_REVIEW_BASE_OID=$review_base DEVFLOW_REVIEW_HEAD_OID=$review_head nvim --clean --listen $manual_nvim_socket -u $render_init"

  set startup_hunk_pid [wait_for_nvim_terminal_pid $startup_nvim_socket]
  set manual_hunk_pid [wait_for_nvim_terminal_pid $manual_nvim_socket]
  wait_for_screen $startup_host_socket startup:0.0 {palette.txt}
  wait_for_screen $manual_host_socket manual:0.0 {palette.txt}
  set content_needles [list green {GREEN changed} peach]
  set startup_signature [wait_for_render_signature $startup_host_socket startup:0.0 $content_needles]
  set manual_signature [wait_for_render_signature $manual_host_socket manual:0.0 $content_needles]
  set startup_palette [lindex $startup_signature 0]
  set manual_palette [lindex $manual_signature 0]
  set startup_content_styles [lindex $startup_signature 1]
  set manual_content_styles [lindex $manual_signature 1]
  set signatures_match [expr {$startup_signature eq $manual_signature}]

  catch { exec nvim --server $startup_nvim_socket --remote-expr {execute('qa!')} }
  catch { exec nvim --server $manual_nvim_socket --remote-expr {execute('qa!')} }
  if {![wait_for_process_exit $startup_hunk_pid] || ![wait_for_process_exit $manual_hunk_pid]} {
    error "FAIL color-comparison Hunk process survived Neovim exit"
  }
  set startup_hunk_pid ""
  set manual_hunk_pid ""
  if {![palette_has_rgb $manual_palette]} {
    error "HARNESS ERROR: post-startup <leader>gd did not render any RGB ANSI colors\n  <leader>gd: [printable_palette $manual_palette]"
  }
  if {!$signatures_match} {
    error "FAIL nvim +HunkReview and the post-startup <leader>gd action render different content-bound ANSI styles\n  +HunkReview palette: [printable_palette $startup_palette]\n  <leader>gd palette: [printable_palette $manual_palette]\n  +HunkReview content: [printable_content_styles $startup_content_styles]\n  <leader>gd content: [printable_content_styles $manual_content_styles]"
  }

  set menu_pattern {File +View +Navigate +(Theme +)?Agent +Help}
  exec tmux -S $direct_socket -f /dev/null new-session -d -x 80 -y 21 -s direct -c $fixture \
    "exec /usr/bin/env TERM=tmux-256color hunk diff --watch --mode stack"
  set direct_hunk_pid [string trim [exec tmux -S $direct_socket display-message -p -t direct:0.0 {#{pane_pid}}]]
  set direct [wait_for_screen $direct_socket direct:0.0 $menu_pattern]
  set direct_first_row [lindex [split $direct "\n"] 0]
  if {![regexp $menu_pattern $direct_first_row]} {
    error "HARNESS ERROR: direct Hunk menu was not on the first row"
  }

  spawn -noecho /usr/bin/env TERM=xterm-256color HUNK_RENDER_FIXTURE=$fixture HUNK_RENDER_SECOND_FIXTURE=$second_fixture \
    DOTFILES_REPO_ROOT=$repo_root \
    tmux -S $host_socket -f /dev/null new-session -s host \
    "nvim --clean --listen $nvim_socket -u $repo_root/nvim/tests/terminal_tool_hunk_render_init.lua"
  set host_spawn_id $spawn_id
  set host_slave $spawn_out(slave,name)
  log_user 0
  exec stty rows 24 columns 80 < $host_slave
  set nvim_hunk_pid [wait_for_nvim_terminal_pid $nvim_socket]
  wait_for_screen $host_socket host:0.0 {sample.txt}
  if {[catch { wait_for_row $host_socket host:0.0 1 $menu_pattern } initial]} {
    set initial [capture $host_socket host:0.0]
  } else {
    after 100
    set initial [capture $host_socket host:0.0]
  }

  lassign [current_nvim_size $nvim_socket] width height

  if {$width != 80 || $height != 20} {
    error "HARNESS ERROR: expected an 80x20 Hunk Tool Tab below Neovim's tabline, got ${width}x${height}"
  }

  set initial_menu_row [lindex [split $initial "\n"] 1]
  set menu_present [regexp $menu_pattern $initial_menu_row]
  set protocol_present [expr {[string first {Gi=31337} $initial] >= 0}]

  if {$menu_present && !$protocol_present} {
    exec nvim --server $nvim_socket --remote-expr \
      {luaeval("HunkRenderOpenSecond()")}
    wait_for_terminal_buffer_count $nvim_socket 2
    wait_for_row $host_socket host:0.0 1 $menu_pattern
    wait_for_screen $host_socket host:0.0 {second.txt}

    exec nvim --server $nvim_socket --remote-expr \
      {luaeval("HunkRenderOpen(1)")}
    wait_for_row $host_socket host:0.0 1 $menu_pattern
    wait_for_screen $host_socket host:0.0 {sample.txt}

    set nvim_pane [active_pane $host_socket host:0]
    exec tmux -S $host_socket split-window -h -b -d -t $nvim_pane
    exec tmux -S $host_socket bind-key h select-pane -L
    exec tmux -S $host_socket select-pane -t $nvim_pane
    send -- "\002"
    after 100
    send -- "h"
    wait_for_active_pane_change $host_socket host:0 $nvim_pane
    exec tmux -S $host_socket select-pane -t $nvim_pane
    exec tmux -S $host_socket kill-pane -a -t $nvim_pane

    exec tmux -S $host_socket new-session -d -s other
    send -- "\002s"
    expect {
      -re {other} {}
      timeout { error "FAIL host tmux session picker did not receive C-b s while Hunk was open" }
    }
    send -- "\033"
    after 200

    exec stty rows 34 columns 100 < $host_slave
    wait_for_nvim_size $nvim_socket 100 30
    set resized [capture $host_socket host:0.0]
    set resized_menu_row [lindex [split $resized "\n"] 1]
    if {![regexp $menu_pattern $resized_menu_row]} {
      error "FAIL Hunk lost its menu after the live host resize"
    }

    exec nvim --server $nvim_socket --remote-expr \
      {luaeval("HunkRenderOpen(2)")}
    wait_for_row $host_socket host:0.0 1 $menu_pattern
    wait_for_screen $host_socket host:0.0 {second.txt}
    exec nvim --server $nvim_socket --remote-expr \
      {luaeval("HunkRenderOpen(1)")}
    wait_for_row $host_socket host:0.0 1 $menu_pattern
    wait_for_screen $host_socket host:0.0 {sample.txt}
    exec nvim --server $nvim_socket --remote-expr \
      {luaeval("vim.fn.jobstop(vim.b.terminal_job_id)")}
    wait_for_terminal_buffer_count $nvim_socket 1

    exec nvim --server $nvim_socket --remote-expr \
      {luaeval("HunkRenderOpen(2)")}
    wait_for_row $host_socket host:0.0 1 $menu_pattern
    wait_for_screen $host_socket host:0.0 {second.txt}

    return "PASS nvim +HunkReview matches the post-startup <leader>gd ANSI palette; two production Hunk Tool Tabs render cleanly, survive tab switches and a native 80x20 to 100x30 resize, isolate process exit, and leave C-b s plus C-b h with host tmux"
  }

  if {$menu_present} {
    error "FAIL real Hunk initial render through terminal_tool\n  the complete menu is present, but the Gi=31337 graphics-protocol artifact remains"
  }

  exec nvim --server $nvim_socket --remote-expr \
    {luaeval("vim.api.nvim_input_mouse('left', 'press', '', 0, 0, 4)")}
  exec nvim --server $nvim_socket --remote-expr \
    {luaeval("vim.api.nvim_input_mouse('left', 'release', '', 0, 0, 4)")}

  wait_for_screen $host_socket host:0.0 {Toggle files/filter focus}
  set protocol_artifact [expr {$protocol_present ? "present" : "absent"}]
  error "FAIL real Hunk initial render through terminal_tool\n  direct 80x21 Hunk renders its complete menu\n  terminal_tool 80x21 initial row is the separator; the complete menu is absent\n  clicking the missing File area reveals: Toggle files/filter focus (Gi protocol artifact $protocol_artifact)"
}

set status [catch { run_test } result]
set cleanup_errors [cleanup \
  [list $host_socket $direct_socket $startup_host_socket $manual_host_socket] \
  [list $host_socket $direct_socket $nvim_socket $startup_host_socket $manual_host_socket $startup_nvim_socket $manual_nvim_socket] \
  [list $fixture $second_fixture $review_fixture $startup_fixture $manual_fixture]]
if {$host_spawn_id ne ""} {
  catch { close -i $host_spawn_id }
  catch { wait -i $host_spawn_id }
}

if {[llength $cleanup_errors] > 0} {
  set cleanup_message "cleanup failed: [join $cleanup_errors {; }]"
  if {$status} {
    append result "\n$cleanup_message"
  } else {
    set status 1
    set result $cleanup_message
  }
}

if {$status} {
  puts stderr $result
  exit 1
}

puts $result
